--!strict
-- Monster catalog. Price and Income are base values before mutation and
-- rebirth multipliers. Mesh asset ids come from AssetIds (generated by
-- scripts/upload_assets.py); monsters without one use a placeholder model.

local AssetIds = require(script.Parent.AssetIds)

export type Monster = {
	Id: string,
	DisplayName: string,
	Rarity: string,
	Price: number,
	Income: number,
	Color: Color3,
	AssetId: number?,
}

local list: { Monster } = {
	-- Common
	{ Id = "Blobby", DisplayName = "Blobby", Rarity = "Common", Price = 25, Income = 1, Color = Color3.fromRGB(140, 230, 80) },
	{ Id = "Mushlet", DisplayName = "Mushlet", Rarity = "Common", Price = 40, Income = 2, Color = Color3.fromRGB(230, 60, 60) },
	{ Id = "Pebblebug", DisplayName = "Pebblebug", Rarity = "Common", Price = 60, Income = 3, Color = Color3.fromRGB(150, 140, 130) },
	-- Uncommon
	{ Id = "Toastling", DisplayName = "Toastling", Rarity = "Uncommon", Price = 200, Income = 8, Color = Color3.fromRGB(220, 160, 80) },
	{ Id = "Fluffnado", DisplayName = "Fluffnado", Rarity = "Uncommon", Price = 320, Income = 12, Color = Color3.fromRGB(235, 235, 255) },
	-- Rare
	{ Id = "Cactopus", DisplayName = "Cactopus", Rarity = "Rare", Price = 1_500, Income = 40, Color = Color3.fromRGB(60, 170, 90) },
	{ Id = "Bubblefin", DisplayName = "Bubblefin", Rarity = "Rare", Price = 2_400, Income = 60, Color = Color3.fromRGB(80, 180, 255) },
	-- Epic
	{ Id = "Moltenpup", DisplayName = "Moltenpup", Rarity = "Epic", Price = 10_000, Income = 200, Color = Color3.fromRGB(255, 100, 30) },
	{ Id = "Frostbun", DisplayName = "Frostbun", Rarity = "Epic", Price = 16_000, Income = 300, Color = Color3.fromRGB(170, 230, 255) },
	-- Legendary
	{ Id = "Thunderoo", DisplayName = "Thunderoo", Rarity = "Legendary", Price = 75_000, Income = 1_200, Color = Color3.fromRGB(255, 230, 60) },
	{ Id = "Crystalwing", DisplayName = "Crystalwing", Rarity = "Legendary", Price = 110_000, Income = 1_700, Color = Color3.fromRGB(200, 120, 255) },
	-- Mythic
	{ Id = "Galaxicat", DisplayName = "Galaxicat", Rarity = "Mythic", Price = 500_000, Income = 7_000, Color = Color3.fromRGB(90, 40, 160) },
	-- Secret
	{ Id = "VoidDuckling", DisplayName = "Void Duckling", Rarity = "Secret", Price = 5_000_000, Income = 50_000, Color = Color3.fromRGB(25, 10, 40) },
}

local byId: { [string]: Monster } = {}
local byRarity: { [string]: { Monster } } = {}
for _, monster in list do
	monster.AssetId = AssetIds[monster.Id]
	byId[monster.Id] = monster
	byRarity[monster.Rarity] = byRarity[monster.Rarity] or {}
	table.insert(byRarity[monster.Rarity], monster)
end

return {
	List = list,
	ById = byId,
	ByRarity = byRarity,
}
